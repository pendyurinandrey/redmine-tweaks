<%# Redmine Tweaks, feature "calendar weeks": the core calendar block markup plus a form for the number of weeks. Not placed under my/blocks on purpose: Redmine registers every plugin partial there as a separate My page block. %>
<div class="contextual">
  <%= link_to_function sprite_icon('settings', l(:label_options)), "$('##{block}-settings').toggle();", :class => 'icon-only icon-settings', :title => l(:label_options) %>
</div>

<h3><%= l(:label_calendar) %></h3>

<div id="<%= block %>-settings" style="display:none;">
  <%= form_tag(my_page_path, :remote => true) do %>
    <div class="box">
      <p>
        <label>
          <%= l(:label_date_range) %>
          <%= select_tag "settings[#{block}][weeks]",
                options_for_select((RedmineTweaks::CalendarWeeks::MIN..RedmineTweaks::CalendarWeeks::MAX).map {|n| [l(:text_tweaks_x_weeks, :count => n), n]}, weeks),
                :id => "#{block}-weeks", :size => 1 %>
        </label>
      </p>
    </div>
    <p>
      <%= submit_tag l(:button_save) %>
      <%= link_to_function l(:button_cancel), "$('##{block}-settings').toggle();" %>
    </p>
  <% end %>
</div>

<%= render :partial => 'common/calendar', :locals => {:calendar => calendar } %>
